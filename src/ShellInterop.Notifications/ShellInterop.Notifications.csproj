<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Windows SDK .NET projection (CsWinRT, shipped with the .NET SDK targeting pack) needs a versioned Windows TFM.
         19041 is the lowest version proven by SHELL-NOTIF-02 (method P). Core / JumpList stay on net10.0-windows. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <DeterministicSourcePaths>true</DeterministicSourcePaths>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>ShellInterop.Notifications</PackageId>
    <Version>0.1.0-preview.1</Version>
    <Authors>moz</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Description>Windows Toast sender (Windows SDK .NET projection, no Windows App SDK) with read-only AUMID shortcut inspection. Pre-release; not a Microsoft product.</Description>
    <!-- Intentionally NO UseWPF / UseWindowsForms / Windows App SDK PackageReference. -->
    <!-- NuGet metadata (same conventions as ShellInterop.Core). Signing is not set. -->
    <RepositoryUrl>https://github.com/moz65535/ShellInterop.Core</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/moz65535/ShellInterop.Core</PackageProjectUrl>
    <Product>ShellInterop.Notifications</Product>
    <Copyright>Copyright (c) 2026 moz</Copyright>
    <PackageTags>notification;toast;windows;shell;appusermodelid;aumid</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ShellInterop.Core.Tests" />
    <!-- Package-specific README (the repository README links to files that do not exist inside the package). -->
    <None Include="..\..\docs\NOTIFICATIONS-PACKAGE-README.md" Pack="true" PackagePath="README.md" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
